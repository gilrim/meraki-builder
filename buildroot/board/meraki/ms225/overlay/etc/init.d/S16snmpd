#!/bin/sh
# Read-only SNMP v2c IF-MIB for switch-port counters.  configd owns the
# authoritative runtime environment and starts this service only after a valid
# portstats snapshot has been published.
DAEMON=${SNMPD_DAEMON:-/usr/sbin/mini-snmpd}
ENV_FILE=${CONFIGD_SNMPD_ENV:-/run/postmerkos/snmpd.env}
PIDFILE=${SNMPD_PIDFILE:-/run/mini_snmpd.pid}
MGMT_IFACE=${SNMPD_MGMT_IFACE:-linux_mgmt}
UDP_PORT=${SNMPD_UDP_PORT:-161}

start() {
    [ -x "$DAEMON" ] || { echo "snmpd: missing binary"; return 1; }
    [ -f "$ENV_FILE" ] || { echo "snmpd: no runtime env yet"; return 0; }
    # shellcheck disable=SC1090
    . "$ENV_FILE"
    [ "${SNMP_ENABLED:-0}" = 1 ] || { echo "snmpd: disabled"; return 0; }

    set -- -n -p "$UDP_PORT" \
        -c "${SNMP_COMMUNITY:-public}" \
        -L "${SNMP_LOCATION:-}" \
        -C "${SNMP_CONTACT:-}" \
        -i "$MGMT_IFACE"
    # mini-snmpd -I binds the UDP listener to a Linux device.  configd emits
    # this only when management_only is enabled.
    [ -n "${SNMP_BIND_DEVICE:-}" ] && set -- "$@" -I "$SNMP_BIND_DEVICE"

    printf 'Starting mini_snmpd: '
    if start-stop-daemon -S -b -m -p "$PIDFILE" -x "$DAEMON" -- "$@"; then
        echo OK
    else
        echo FAIL
        return 1
    fi
}

stop() {
    printf 'Stopping mini_snmpd: '
    start-stop-daemon -K -q -p "$PIDFILE" -x "$DAEMON" 2>/dev/null || true
    rm -f "$PIDFILE"
    echo OK
}

case "$1" in
    start) start ;;
    stop) stop ;;
    restart|reload) stop && sleep 1 && start ;;
    *) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac

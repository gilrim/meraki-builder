#!/bin/sh

DAEMON=/usr/bin/uhttpd
[ -x "$DAEMON" ] || DAEMON=/usr/sbin/uhttpd
PIDFILE=/var/run/uhttpd.pid
WEBROOT=/www
LOGFILE=/tmp/uhttpd.log
PORT_HEX=0050

is_running() {
    [ -s "$PIDFILE" ] || return 1
    pid=$(cat "$PIDFILE" 2>/dev/null) || return 1
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

listener_ready() {
    for table in /proc/net/tcp /proc/net/tcp6; do
        [ -r "$table" ] || continue
        awk -v port=":$PORT_HEX" '
            NR > 1 && $2 ~ port "$" && $4 == "0A" { found=1 }
            END { exit found ? 0 : 1 }
        ' "$table" && return 0
    done
    return 1
}

wait_until_ready() {
    attempts=0
    while [ "$attempts" -lt 10 ]; do
        is_running || return 1
        listener_ready && return 0
        attempts=$((attempts + 1))
        sleep 1
    done
    return 1
}

start() {
    printf 'Starting postmerkOS web interface: '
    [ -x "$DAEMON" ] || { echo 'FAIL (missing uhttpd)'; return 1; }
    [ -f "$WEBROOT/index.html" ] || { echo 'FAIL (missing /www/index.html)'; return 1; }

    if is_running; then
        if listener_ready; then
            echo 'already running'
            return 0
        fi
        start-stop-daemon -K -q -p "$PIDFILE" -x "$DAEMON" >/dev/null 2>&1 || true
        rm -f "$PIDFILE"
    fi

    mkdir -p /var/run
    touch "$LOGFILE"
    printf '%s uhttpd start requested\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date)" >>"$LOGFILE"
    rm -f "$PIDFILE"
    start-stop-daemon -S -q -b -m -p "$PIDFILE" -x "$DAEMON" -- \
        -f -p 0.0.0.0:80 -h "$WEBROOT" >>"$LOGFILE" 2>&1
    rc=$?
    if [ "$rc" -ne 0 ]; then
        echo FAIL
        tail -n 40 "$LOGFILE"
        return "$rc"
    fi

    if ! wait_until_ready; then
        echo 'FAIL (uhttpd did not remain alive and listen on TCP 80)'
        tail -n 40 "$LOGFILE"
        if is_running; then
            start-stop-daemon -K -q -p "$PIDFILE" -x "$DAEMON" >/dev/null 2>&1 || true
        fi
        rm -f "$PIDFILE"
        return 1
    fi

    echo OK
}

stop() {
    printf 'Stopping postmerkOS web interface: '
    if ! is_running; then
        rm -f "$PIDFILE"
        echo 'not running'
        return 0
    fi
    start-stop-daemon -K -q -p "$PIDFILE" -x "$DAEMON"
    rc=$?
    rm -f "$PIDFILE"
    [ "$rc" -eq 0 ] && echo OK || echo FAIL
    return "$rc"
}

rebind() {
    old_address=${1:-unknown}
    new_address=${2:-unknown}
    echo "Rebinding postmerkOS web interface: $old_address -> $new_address"
    stop
    sleep 1
    start
}

status() {
    is_running && listener_ready
}

case "$1" in
    start) start ;;
    stop) stop ;;
    restart|reload) stop; sleep 1; start ;;
    rebind) shift; rebind "$@" ;;
    status) status ;;
    *) echo "Usage: $0 {start|stop|restart|reload|rebind|status}"; exit 1 ;;
esac

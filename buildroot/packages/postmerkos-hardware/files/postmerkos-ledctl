#!/bin/sh
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
RUNDIR=${POSTMERKOS_RUN_DIR:-/run/postmerkos}
HWPROBE=${POSTMERKOS_HWPROBE:-/usr/sbin/postmerkos-hwprobe}
CTL=${POSTMERKOSCTL:-postmerkosctl}
POE_LEDS=${POSTMERKOS_POE_LEDS:-poe_leds}
OWNER=$RUNDIR/led-owner
STATE=$RUNDIR/led-state
ANIMATOR_PID=$RUNDIR/led-animator.pid
CAP_ENV=$RUNDIR/led-capabilities.env
RESTORE=$RUNDIR/status-led-restore
mkdir -p "$RUNDIR"

refresh_caps() {
    "$HWPROBE" refresh >/dev/null 2>&1 || true
    PORT_LED_BACKEND=unidentified PORT_LED_HANDLER= PORT_LED_AVAILABLE=0 PORT_LED_VERIFIED=0
    STATUS_LED_BACKEND=unidentified STATUS_LED_PATH= STATUS_LED_ACTIVE=1 STATUS_LED_AVAILABLE=0 STATUS_LED_VERIFIED=0
    [ -r "$CAP_ENV" ] && . "$CAP_ENV"
}

ports() {
    p=$("$CTL" status 2>/dev/null | sed -n 's/.*"copper_ports"[[:space:]]*:[[:space:]]*\([0-9]*\).*/\1/p' | sed -n '1p')
    [ -n "$p" ] || p=$(cat /tmp/NUM_PORTS 2>/dev/null || echo 0)
    [ "$p" -gt 48 ] 2>/dev/null && p=48
    echo "${p:-0}"
}

set_port() {
    [ "$PORT_LED_AVAILABLE" = 1 ] || return 1
    printf 'PORT %s, STATE %s\n' "$1" "$2" >"$PORT_LED_HANDLER" 2>/dev/null
}

set_status() {
    [ "$STATUS_LED_AVAILABLE" = 1 ] || return 1
    printf '%s\n' "$1" >"$STATUS_LED_PATH" 2>/dev/null
}

sleep_ms() {
    ms=$1
    seconds=$((ms / 1000)); millis=$((ms % 1000))
    sleep "$(printf '%d.%03d' "$seconds" "$millis")"
}

owner_priority() {
    case "${1:-normal}" in
        fatal|error) echo 50 ;;
        firmware) echo 40 ;;
        reset) echo 30 ;;
        identify|identification) echo 20 ;;
        *) echo 0 ;;
    esac
}

stop_animator() {
    if [ -s "$ANIMATOR_PID" ]; then
        pid=$(cat "$ANIMATOR_PID" 2>/dev/null || true)
        [ -n "$pid" ] && kill "$pid" 2>/dev/null || true
        rm -f "$ANIMATOR_PID"
    fi
}

start_animator() {
    [ "$STATUS_LED_AVAILABLE" = 1 ] && [ "$STATUS_LED_VERIFIED" = 1 ] || return 1
    if [ -s "$ANIMATOR_PID" ] && kill -0 "$(cat "$ANIMATOR_PID" 2>/dev/null)" 2>/dev/null; then return 0; fi
    "$0" _animate >"$RUNDIR/ledctl.log" 2>&1 &
    echo $! >"$ANIMATOR_PID"
}

animate() {
    trap 'rm -f "$ANIMATOR_PID"; exit 0' EXIT HUP INT TERM
    while [ -s "$OWNER" ] && [ -r "$STATE" ]; do
        refresh_caps
        [ "$STATUS_LED_AVAILABLE" = 1 ] || exit 0
        mode=$(sed -n 's/^mode=//p' "$STATE" | sed -n '1p')
        pct=$(sed -n 's/^progress=//p' "$STATE" | sed -n '1p')
        case "$pct" in ''|*[!0-9]*) pct=0 ;; esac
        [ "$pct" -gt 100 ] && pct=100
        [ "$pct" -lt 0 ] && pct=0
        case "$mode" in
            progress|reset)
                cycle=$((2000 - (1200 * pct / 100)))
                on=$((500 - (200 * pct / 100)))
                off=$((cycle - on))
                set_status "$STATUS_LED_ACTIVE" || exit 0
                sleep_ms "$on"
                inactive=0; [ "$STATUS_LED_ACTIVE" = 0 ] && inactive=1
                set_status "$inactive" || exit 0
                sleep_ms "$off"
                ;;
            error)
                set_status "$STATUS_LED_ACTIVE" || exit 0; sleep_ms 250
                inactive=0; [ "$STATUS_LED_ACTIVE" = 0 ] && inactive=1
                set_status "$inactive" || exit 0; sleep_ms 150
                set_status "$STATUS_LED_ACTIVE" || exit 0; sleep_ms 250
                set_status "$inactive" || exit 0; sleep_ms 150
                set_status "$STATUS_LED_ACTIVE" || exit 0; sleep_ms 250
                set_status "$inactive" || exit 0; sleep_ms 1000
                ;;
            *) exit 0 ;;
        esac
    done
}

select_output() {
    if [ "$PORT_LED_AVAILABLE" = 1 ]; then echo ports
    elif [ "$STATUS_LED_AVAILABLE" = 1 ] && [ "$STATUS_LED_VERIFIED" = 1 ]; then echo status
    else echo unavailable
    fi
}

port_progress() {
    pct=$1; n=$(ports); lit=$(( (n * pct + 50) / 100 )); i=1
    while [ "$i" -le "$n" ]; do
        [ "$i" -le "$lit" ] && state=1 || state=0
        set_port "$i" "$state" || true
        i=$((i+1))
    done
}

case "${1:-status}" in
  _animate) animate ;;
  capabilities)
    refresh_caps
    [ -r "$RUNDIR/hardware-controls.json" ] && cat "$RUNDIR/hardware-controls.json" || echo '{"leds":{"ports":{"available":false},"status":{"available":false}}}'
    ;;
  acquire)
    refresh_caps
    owner=${2:-unknown}
    current=$(cat "$OWNER" 2>/dev/null || true)
    if [ -n "$current" ] && [ "$current" != "$owner" ]; then
        current_priority=$(owner_priority "$current")
        requested_priority=$(owner_priority "$owner")
        [ "$requested_priority" -gt "$current_priority" ] || exit 1
        stop_animator
    fi
    if [ -z "$current" ] && [ "$STATUS_LED_AVAILABLE" = 1 ] && [ -r "$STATUS_LED_PATH" ]; then
        cat "$STATUS_LED_PATH" >"$RESTORE" 2>/dev/null || true
    fi
    printf '%s\n' "$owner" >"$OWNER"
    ;;
  release)
    refresh_caps
    owner=${2:-}
    current=$(cat "$OWNER" 2>/dev/null || true)
    [ -z "$owner" ] || [ "$current" = "$owner" ] || exit 1
    stop_animator
    rm -f "$OWNER" "$STATE"
    if [ "$STATUS_LED_AVAILABLE" = 1 ] && [ -r "$RESTORE" ]; then cat "$RESTORE" >"$STATUS_LED_PATH" 2>/dev/null || true; fi
    rm -f "$RESTORE"
    [ "$PORT_LED_AVAILABLE" = 1 ] && command -v "$POE_LEDS" >/dev/null 2>&1 && "$POE_LEDS" >/dev/null 2>&1 || true
    ;;
  all-off|all-on)
    refresh_caps
    output=$(select_output)
    if [ "$output" = ports ]; then
        n=$(ports); i=1; [ "$1" = all-on ] && state=1 || state=0
        while [ "$i" -le "$n" ]; do set_port "$i" "$state" || true; i=$((i+1)); done
    elif [ "$output" = status ]; then
        [ "$1" = all-on ] && state=$STATUS_LED_ACTIVE || { state=0; [ "$STATUS_LED_ACTIVE" = 0 ] && state=1; }
        set_status "$state" || true
    fi
    ;;
  progress|reset-progress)
    refresh_caps
    pct=${2:-0}; case "$pct" in ''|*[!0-9]*) pct=0 ;; esac
    [ "$pct" -gt 100 ] && pct=100
    output=$(select_output)
    if [ "$output" = ports ]; then port_progress "$pct"
    elif [ "$output" = status ]; then
        [ "$1" = reset-progress ] && mode=reset || mode=progress
        printf 'mode=%s\nprogress=%s\n' "$mode" "$pct" >"$STATE"
        start_animator || true
    fi
    ;;
  reset-step)
    second=${2:-0}; pct=$((second * 10)); [ "$pct" -gt 100 ] && pct=100
    exec "$0" reset-progress "$pct"
    ;;
  error)
    refresh_caps
    output=$(select_output)
    if [ "$output" = status ]; then printf 'mode=error\nprogress=100\n' >"$STATE"; start_animator || true
    elif [ "$output" = ports ]; then
        count=0; while [ "$count" -lt 10 ]; do "$0" all-on; sleep 1; "$0" all-off; sleep 1; count=$((count+1)); done
    fi
    ;;
  status) [ -f "$OWNER" ] && cat "$OWNER" || echo normal ;;
  test-status)
    refresh_caps
    [ "$STATUS_LED_AVAILABLE" = 1 ] || { echo 'No registered status LED path.' >&2; exit 1; }
    echo "Testing $STATUS_LED_PATH; observe the chassis LED."
    old=$(cat "$STATUS_LED_PATH" 2>/dev/null || echo 0)
    set_status "$STATUS_LED_ACTIVE"; sleep 1
    inactive=0; [ "$STATUS_LED_ACTIVE" = 0 ] && inactive=1
    set_status "$inactive"; sleep 1
    printf '%s\n' "$old" >"$STATUS_LED_PATH" 2>/dev/null || true
    ;;
  *) echo 'usage: postmerkos-ledctl capabilities|acquire OWNER|release [OWNER]|progress PCT|reset-progress PCT|error|reset-step SECOND|all-on|all-off|status|test-status' >&2; exit 2 ;;
esac

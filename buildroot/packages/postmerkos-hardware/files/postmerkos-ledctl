#!/bin/sh
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
RUNDIR=${POSTMERKOS_RUN_DIR:-/run/postmerkos}
HWPROBE=${POSTMERKOS_HWPROBE:-/usr/sbin/postmerkos-hwprobe}
CTL=${POSTMERKOSCTL:-postmerkosctl}
POE_LEDS=${POSTMERKOS_POE_LEDS:-poe_leds}
OWNER=$RUNDIR/led-owner
STATE=$RUNDIR/led-state
ANIMATOR_PID=$RUNDIR/led-animator.pid
ANIMATOR_LOCK=$RUNDIR/led-animator.lock
CONTROL_LOCK=$RUNDIR/led-control.lock
CONTROL_LOCK_HELD=0
CAP_ENV=$RUNDIR/led-capabilities.env
RESTORE_GREEN=$RUNDIR/status-led-green.restore
RESTORE_ORANGE=$RUNDIR/status-led-orange.restore
mkdir -p "$RUNDIR"
refresh_caps() {
    # S16postmerkos-hardware probes the exact board once after Click is ready.
    # Re-running the full probe for every LED command can take long enough to
    # stall physical-button sampling, so use that atomic cache on the hot path.
    # Missing caches still self-heal, and diagnostics may explicitly force a
    # refresh with POSTMERKOS_LED_FORCE_REFRESH=1.
    if { [ ! -r "$CAP_ENV" ] || [ "${POSTMERKOS_LED_FORCE_REFRESH:-0}" = 1 ]; } &&
       [ "${POSTMERKOS_LED_SKIP_REFRESH:-0}" != 1 ]; then
        "$HWPROBE" refresh >/dev/null 2>&1 || true
    fi
    PORT_LED_AVAILABLE=0 PORT_LED_VERIFIED=0 PORT_LED_HANDLER=
    STATUS_LED_AVAILABLE=0 STATUS_LED_VERIFIED=0 STATUS_LED_GREEN_PATH= STATUS_LED_ORANGE_PATH= STATUS_LED_PROTOCOL=plain-bool
    [ -r "$CAP_ENV" ] && . "$CAP_ENV"
    export PORT_LED_AVAILABLE PORT_LED_VERIFIED PORT_LED_HANDLER
    export STATUS_LED_AVAILABLE STATUS_LED_VERIFIED STATUS_LED_GREEN_PATH STATUS_LED_ORANGE_PATH STATUS_LED_PROTOCOL
}
ports() {
    p=$("$CTL" status 2>/dev/null | sed -n 's/.*"copper_ports"[[:space:]]*:[[:space:]]*\([0-9]*\).*/\1/p' | sed -n '1p')
    [ -n "$p" ] || p=0
    [ "$p" -gt 8 ] 2>/dev/null && p=8
    echo "${p:-0}"
}
write_status_value() {
    path=$1 value=$2
    [ -w "$path" ] || return 1
    case "$STATUS_LED_PROTOCOL" in
      named-state) printf 'STATE %s\n' "$value" >"$path" ;;
      plain-bool|*) printf '%s\n' "$value" >"$path" ;;
    esac
}
read_status_value() {
    path=$1
    value=$(cat "$path" 2>/dev/null || true)
    parsed=$(printf '%s\n' "$value" | sed -n 's/.*STATE[[:space:]]\+\([01]\).*/\1/p; /^[[:space:]]*[01][[:space:]]*$/ { s/[[:space:]]//g; p; }' | tail -n 1)
    [ -n "$parsed" ] || parsed=0
    printf '%s\n' "$parsed"
}
set_colour() {
    colour=$1 state=${2:-1}
    [ "$STATUS_LED_AVAILABLE" = 1 ] && [ "$STATUS_LED_VERIFIED" = 1 ] || return 1
    case "$colour" in
      green) write_status_value "$STATUS_LED_ORANGE_PATH" 0; write_status_value "$STATUS_LED_GREEN_PATH" "$state" ;;
      orange) write_status_value "$STATUS_LED_GREEN_PATH" 0; write_status_value "$STATUS_LED_ORANGE_PATH" "$state" ;;
      off) write_status_value "$STATUS_LED_GREEN_PATH" 0; write_status_value "$STATUS_LED_ORANGE_PATH" 0 ;;
      *) return 1 ;;
    esac
}
set_port() { [ "$PORT_LED_AVAILABLE" = 1 ] && [ "$PORT_LED_VERIFIED" = 1 ] || return 1; printf 'PORT %s, STATE %s\n' "$1" "$2" >"$PORT_LED_HANDLER"; }
sleep_ms() { ms=$1; sleep "$(printf '%d.%03d' $((ms/1000)) $((ms%1000)))"; }
owner_priority() { case "${1:-normal}" in fatal|error) echo 50;; firmware) echo 40;; reset) echo 30;; identify|identification) echo 20;; *) echo 0;; esac; }
current_owner() { cat "$OWNER" 2>/dev/null || true; }
ledctl_process_matches() {
    pid=$1
    case "$pid" in ''|*[!0-9]*) return 1;; esac
    [ -r "/proc/$pid/cmdline" ] || return 1
    command_line=$(tr '\000' ' ' <"/proc/$pid/cmdline" 2>/dev/null || true)
    case "$command_line" in *postmerkos-ledctl*) return 0;; *) return 1;; esac
}
release_control_lock() {
    [ "$CONTROL_LOCK_HELD" = 1 ] || return 0
    lock_pid=$(cat "$CONTROL_LOCK/pid" 2>/dev/null || true)
    if [ "$lock_pid" = "$$" ]; then
      rm -f "$CONTROL_LOCK/pid"
      rmdir "$CONTROL_LOCK" 2>/dev/null || true
    fi
    CONTROL_LOCK_HELD=0
}
acquire_control_lock() {
    attempts=0
    missing_pid_attempts=0
    max_attempts=${POSTMERKOS_LED_LOCK_ATTEMPTS:-300}
    case "$max_attempts" in ''|*[!0-9]*) max_attempts=300;; esac
    [ "$max_attempts" -gt 0 ] 2>/dev/null || max_attempts=1
    while ! mkdir "$CONTROL_LOCK" 2>/dev/null; do
      lock_pid=$(cat "$CONTROL_LOCK/pid" 2>/dev/null || true)
      if [ -z "$lock_pid" ]; then
        # mkdir is the atomic acquisition. Give its owner time to publish the
        # PID before treating a PID-less directory as stale.
        missing_pid_attempts=$((missing_pid_attempts + 1))
        if [ "$missing_pid_attempts" -ge 50 ]; then
          rmdir "$CONTROL_LOCK" 2>/dev/null || true
          missing_pid_attempts=0
        fi
      elif ! ledctl_process_matches "$lock_pid"; then
        rm -f "$CONTROL_LOCK/pid" 2>/dev/null || true
        rmdir "$CONTROL_LOCK" 2>/dev/null || true
        missing_pid_attempts=0
        continue
      else
        missing_pid_attempts=0
      fi
      attempts=$((attempts + 1))
      [ "$attempts" -lt "$max_attempts" ] || return 1
      sleep 0.01
    done
    printf '%s\n' "$$" >"$CONTROL_LOCK/pid"
    CONTROL_LOCK_HELD=1
    trap 'release_control_lock' EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
}
animator_matches() {
    pid=$1
    case "$pid" in ''|*[!0-9]*) return 1;; esac
    [ -r "/proc/$pid/cmdline" ] || return 1
    command_line=$(tr '\000' ' ' <"/proc/$pid/cmdline" 2>/dev/null || true)
    case "$command_line" in *postmerkos-ledctl*'_animate'*) return 0;; *) return 1;; esac
}
stop_animator() {
    pid=$(cat "$ANIMATOR_PID" 2>/dev/null || true)
    if animator_matches "$pid"; then
      kill "$pid" 2>/dev/null || true
      attempts=0
      while animator_matches "$pid" && [ "$attempts" -lt 40 ]; do
        sleep 0.05
        attempts=$((attempts + 1))
      done
      if animator_matches "$pid"; then
        kill -KILL "$pid" 2>/dev/null || true
        sleep 0.05
      fi
    fi
    rm -f "$ANIMATOR_PID"
    rmdir "$ANIMATOR_LOCK" 2>/dev/null || true
}
start_animator() {
    [ -s "$OWNER" ] || return 1
    [ "$STATUS_LED_AVAILABLE" = 1 ] && [ "$STATUS_LED_VERIFIED" = 1 ] || return 1
    pid=$(cat "$ANIMATOR_PID" 2>/dev/null || true)
    animator_matches "$pid" && return 0
    attempts=0
    while ! mkdir "$ANIMATOR_LOCK" 2>/dev/null; do
      pid=$(cat "$ANIMATOR_PID" 2>/dev/null || true)
      animator_matches "$pid" && return 0
      attempts=$((attempts + 1))
      if [ "$attempts" -ge 20 ]; then
        rm -f "$ANIMATOR_PID"
        rmdir "$ANIMATOR_LOCK" 2>/dev/null || return 1
        attempts=0
      fi
      sleep 0.01
    done
    "$0" _animate >"$RUNDIR/ledctl.log" 2>&1 &
    pid=$!
    printf '%s\n' "$pid" >"$ANIMATOR_PID"
    return 0
}
animate() {
    trap 'rm -f "$ANIMATOR_PID"; rmdir "$ANIMATOR_LOCK" 2>/dev/null || true; set_colour off 0 >/dev/null 2>&1 || true; exit 0' EXIT HUP INT TERM
    while [ -s "$OWNER" ] && [ -r "$STATE" ]; do
      mode=$(sed -n 's/^mode=//p' "$STATE" | sed -n '1p'); pct=$(sed -n 's/^progress=//p' "$STATE" | sed -n '1p')
      case "$pct" in ''|*[!0-9]*) pct=0;; esac; [ "$pct" -gt 100 ] && pct=100
      case "$mode" in
        firmware|progress)
          cycle=$((1600 - 1000*pct/100)); pulse=$(( (cycle - 200) / 2 )); [ "$pulse" -lt 150 ] && pulse=150
          set_colour green 1 || exit 0; sleep_ms "$pulse"; set_colour off 0 || exit 0; sleep_ms 100
          set_colour orange 1 || exit 0; sleep_ms "$pulse"; set_colour off 0 || exit 0; sleep_ms 100 ;;
        reset)
          # The physical-reset countdown must be unmistakable from the normal
          # chassis heartbeat. Start at 2 Hz and accelerate to roughly 8 Hz as
          # the destructive threshold approaches, using an even duty cycle so
          # the orange indication remains visible throughout the hold.
          cycle=$((500 - 380*pct/100)); [ "$cycle" -lt 120 ] && cycle=120
          on=$((cycle / 2)); [ "$on" -lt 60 ] && on=60
          off=$((cycle - on)); [ "$off" -lt 60 ] && off=60
          set_colour orange 1 || exit 0; sleep_ms "$on"; set_colour off 0 || exit 0; sleep_ms "$off" ;;
        error)
          i=0; while [ "$i" -lt 3 ]; do set_colour orange 1 || exit 0; sleep_ms 250; set_colour off 0; sleep_ms 150; i=$((i+1)); done; sleep_ms 1000 ;;
        *) exit 0;;
      esac
    done
}
port_progress() { pct=$1; n=$(ports); lit=$(( (n*pct+50)/100 )); i=1; while [ "$i" -le "$n" ]; do [ "$i" -le "$lit" ] && v=1 || v=0; set_port "$i" "$v" || true; i=$((i+1)); done; }
restore_pair() {
    if [ -r "$RESTORE_GREEN" ] && [ -r "$RESTORE_ORANGE" ]; then
      green=$(cat "$RESTORE_GREEN" 2>/dev/null || echo 0)
      orange=$(cat "$RESTORE_ORANGE" 2>/dev/null || echo 0)
      # GPIO23 is orange-dominant. Clear it before restoring green, then restore
      # the captured orange bit last so every final pair (including 1/1) is exact.
      write_status_value "$STATUS_LED_ORANGE_PATH" 0 || true
      write_status_value "$STATUS_LED_GREEN_PATH" "$green" || true
      write_status_value "$STATUS_LED_ORANGE_PATH" "$orange" || true
    else
      if [ -r "$RESTORE_GREEN" ]; then green=$(cat "$RESTORE_GREEN" 2>/dev/null || echo 0); write_status_value "$STATUS_LED_GREEN_PATH" "$green" || true; fi
      if [ -r "$RESTORE_ORANGE" ]; then orange=$(cat "$RESTORE_ORANGE" 2>/dev/null || echo 0); write_status_value "$STATUS_LED_ORANGE_PATH" "$orange" || true; fi
    fi
    rm -f "$RESTORE_GREEN" "$RESTORE_ORANGE"
}
command=${1:-status}
case "$command" in
  _animate|status) ;;
  *) acquire_control_lock || { echo 'postmerkos-ledctl: control lock timeout' >&2; exit 1; } ;;
esac
case "$command" in
  _animate) animate ;;
  capabilities) refresh_caps; cat "$RUNDIR/hardware-controls.json" 2>/dev/null || echo '{"schema_version":3,"leds":{}}' ;;
  acquire)
    refresh_caps; owner=${2:-unknown}; current=$(cat "$OWNER" 2>/dev/null || true)
    if [ -n "$current" ] && [ "$current" != "$owner" ]; then
      [ "$(owner_priority "$owner")" -gt "$(owner_priority "$current")" ] || exit 1
      # Publish the new owner before stopping the old animator so old-owner
      # progress callbacks can no longer restart it during the handoff.
      printf '%s\n' "$owner" >"$OWNER"
      rm -f "$STATE"
      stop_animator
    elif [ -z "$current" ]; then
      stop_animator; rm -f "$STATE"
      if [ "$STATUS_LED_AVAILABLE" = 1 ]; then read_status_value "$STATUS_LED_GREEN_PATH" >"$RESTORE_GREEN"; read_status_value "$STATUS_LED_ORANGE_PATH" >"$RESTORE_ORANGE"; fi
      printf '%s\n' "$owner" >"$OWNER"
    fi ;;
  release)
    refresh_caps; owner=${2:-}; current=$(cat "$OWNER" 2>/dev/null || true); [ -z "$owner" ] || [ "$current" = "$owner" ] || exit 1
    # Revoke ownership first so a concurrent status callback cannot start a new
    # animator while release is waiting for the current one to terminate.
    rm -f "$OWNER" "$STATE"; stop_animator; restore_pair
    [ "$PORT_LED_AVAILABLE" = 1 ] && command -v "$POE_LEDS" >/dev/null 2>&1 && "$POE_LEDS" >/dev/null 2>&1 || true ;;
  progress|firmware-progress|reset-progress)
    refresh_caps; pct=${2:-0}; case "$pct" in ''|*[!0-9]*) pct=0;; esac; [ "$pct" -gt 100 ] && pct=100
    case "$1" in reset-progress) mode=reset; required_owner=reset;; *) mode=firmware; required_owner=firmware;; esac
    [ "$(current_owner)" = "$required_owner" ] || exit 0
    if [ "$STATUS_LED_AVAILABLE" = 1 ]; then printf 'mode=%s\nprogress=%s\n' "$mode" "$pct" >"$STATE"; start_animator || true
    elif [ "$PORT_LED_AVAILABLE" = 1 ] && [ "$mode" = firmware ]; then port_progress "$pct"; fi ;;
  success) refresh_caps; [ -n "$(current_owner)" ] || exit 0; stop_animator; set_colour green 1 || { [ "$PORT_LED_AVAILABLE" = 1 ] && port_progress 100 || true; } ;;
  error) refresh_caps; [ -n "$(current_owner)" ] || exit 0; printf 'mode=error\nprogress=100\n' >"$STATE"; start_animator || { [ "$PORT_LED_AVAILABLE" = 1 ] && port_progress 100 || true; } ;;
  all-on) refresh_caps; set_colour green 1 || port_progress 100 || true ;;
  all-off) refresh_caps; stop_animator; set_colour off 0 || port_progress 0 || true ;;
  status) [ -f "$OWNER" ] && cat "$OWNER" || echo normal ;;
  test-status) refresh_caps; [ "$STATUS_LED_AVAILABLE" = 1 ] || { echo 'No exact-model verified dual status LED handlers are available.' >&2; exit 1; }; set_colour green 1; sleep 1; set_colour orange 1; sleep 1; set_colour off 0 ;;
  *) echo 'usage: postmerkos-ledctl capabilities|acquire OWNER|release [OWNER]|progress PCT|firmware-progress PCT|reset-progress PCT|success|error|all-on|all-off|status|test-status' >&2; exit 2 ;;
esac

#!/bin/sh
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
RUNDIR=${POSTMERKOS_RUN_DIR:-/run/postmerkos}
PROFILE_DIR=${POSTMERKOS_HARDWARE_PROFILE_DIR:-/usr/share/postmerkos/hardware-controls}
BOARDINFO=${POSTMERKOS_BOARDINFO:-/etc/boardinfo}
CLICK_ROOT=${POSTMERKOS_CLICK_ROOT:-/click}
SYS_ROOT=${POSTMERKOS_SYS_ROOT:-/sys}
PROC_INPUT=${POSTMERKOS_PROC_INPUT:-/proc/bus/input/devices}
DEV_INPUT=${POSTMERKOS_DEV_INPUT:-/dev/input}
RUNTIME_JSON=$RUNDIR/hardware-controls.json
RUNTIME_ENV=$RUNDIR/led-capabilities.env
mkdir -p "$RUNDIR"

model() {
    sed -n 's/^MODEL=//p' "$BOARDINFO" 2>/dev/null | sed -n '1p'
}

load_profile() {
    RESET_BACKEND=unidentified RESET_PATH= RESET_DEVICE= RESET_CODE=0 RESET_ACTIVE=0 RESET_VERIFIED=0
    PORT_LED_BACKEND=click PORT_LED_HANDLER=/click/sw0_ctrl/poe_led_state PORT_LED_VERIFIED=0
    STATUS_LED_BACKEND=unidentified STATUS_LED_PATH= STATUS_LED_ACTIVE=1 STATUS_LED_VERIFIED=0
    if [ -r "$PROFILE_DIR/default.conf" ]; then
        . "$PROFILE_DIR/default.conf"
    fi
    local_model=$(model)
    if [ -n "$local_model" ] && [ -r "$PROFILE_DIR/$local_model.conf" ]; then
        . "$PROFILE_DIR/$local_model.conf"
    fi
}

bool() { [ "${1:-0}" = 1 ] && echo true || echo false; }
json_string() { printf '%s' "${1:-}" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

refresh() {
    load_profile
    local_model=$(model); local_model=${local_model:-unknown}
    port_available=0
    [ "$PORT_LED_BACKEND" = click ] && [ -w "$PORT_LED_HANDLER" ] && port_available=1
    status_available=0
    case "$STATUS_LED_BACKEND" in
        sysfs|sysfs-led|sysfs-gpio|click|platform)
            [ -n "$STATUS_LED_PATH" ] && [ -w "$STATUS_LED_PATH" ] && status_available=1
            ;;
    esac
    reset_available=0
    case "$RESET_BACKEND" in
        sysfs|click) [ -n "$RESET_PATH" ] && [ -r "$RESET_PATH" ] && reset_available=1 ;;
        evdev) [ -n "$RESET_DEVICE" ] && [ -r "$RESET_DEVICE" ] && reset_available=1 ;;
    esac
    cat >"$RUNTIME_JSON" <<JSON
{
  "model": "$(json_string "$local_model")",
  "reset_button": {
    "backend": "$(json_string "$RESET_BACKEND")",
    "path": "$(json_string "$RESET_PATH")",
    "device": "$(json_string "$RESET_DEVICE")",
    "code": ${RESET_CODE:-0},
    "active": ${RESET_ACTIVE:-0},
    "registered": $( [ "$RESET_BACKEND" != unidentified ] && echo true || echo false ),
    "available": $(bool "$reset_available"),
    "verified": $(bool "$RESET_VERIFIED")
  },
  "leds": {
    "ports": {
      "backend": "$(json_string "$PORT_LED_BACKEND")",
      "handler": "$(json_string "$PORT_LED_HANDLER")",
      "registered": $( [ "$PORT_LED_BACKEND" != unidentified ] && echo true || echo false ),
      "available": $(bool "$port_available"),
      "verified": $(bool "$PORT_LED_VERIFIED"),
      "mode": "binary-per-port"
    },
    "status": {
      "backend": "$(json_string "$STATUS_LED_BACKEND")",
      "path": "$(json_string "$STATUS_LED_PATH")",
      "active": ${STATUS_LED_ACTIVE:-1},
      "registered": $( [ "$STATUS_LED_BACKEND" != unidentified ] && echo true || echo false ),
      "available": $(bool "$status_available"),
      "verified": $(bool "$STATUS_LED_VERIFIED"),
      "mode": "binary-single-led"
    }
  }
}
JSON
    cat >"$RUNTIME_ENV" <<ENV
PORT_LED_BACKEND='$PORT_LED_BACKEND'
PORT_LED_HANDLER='$PORT_LED_HANDLER'
PORT_LED_AVAILABLE='$port_available'
PORT_LED_VERIFIED='$PORT_LED_VERIFIED'
STATUS_LED_BACKEND='$STATUS_LED_BACKEND'
STATUS_LED_PATH='$STATUS_LED_PATH'
STATUS_LED_ACTIVE='$STATUS_LED_ACTIVE'
STATUS_LED_AVAILABLE='$status_available'
STATUS_LED_VERIFIED='$STATUS_LED_VERIFIED'
ENV
}

inventory_reset() {
    echo 'Linux input devices:'
    cat "$PROC_INPUT" 2>/dev/null || echo '  unavailable'
    echo
    echo 'Event nodes:'
    ls -l "$DEV_INPUT"/event* 2>/dev/null || echo '  none'
    echo
    echo 'GPIO state:'
    if [ -r "$SYS_ROOT"/kernel/debug/gpio ]; then cat "$SYS_ROOT"/kernel/debug/gpio; else find "$SYS_ROOT"/class/gpio -maxdepth 2 -name value -print 2>/dev/null || true; fi
    echo
    echo 'Click reset/button candidates:'
    find "$CLICK_ROOT" -maxdepth 4 \( -iname '*reset*' -o -iname '*button*' -o -iname '*gpio*' \) -print 2>/dev/null || echo '  none'
}

inventory_leds() {
    echo 'LED class devices:'
    for path in "$SYS_ROOT"/class/leds/*; do
        [ -e "$path" ] || continue
        printf '  %s brightness=' "${path##*/}"
        cat "$path/brightness" 2>/dev/null || echo '?'
        [ -r "$path/trigger" ] && { printf '    trigger='; cat "$path/trigger"; }
    done
    echo
    echo 'Click LED candidates:'
    find "$CLICK_ROOT" -maxdepth 4 -iname '*led*' -print 2>/dev/null || echo '  none'
}

snapshot_paths() {
    for path in "$SYS_ROOT"/class/gpio/gpio*/value "$SYS_ROOT"/class/leds/*/brightness; do
        [ -r "$path" ] || continue
        printf '%s=' "$path"; cat "$path" 2>/dev/null || true
    done | sort
}

watch_changes() {
    seconds=${1:-30}
    case "$seconds" in ''|*[!0-9]*) seconds=30 ;; esac
    old=$RUNDIR/hwprobe-old.$$
    new=$RUNDIR/hwprobe-new.$$
    snapshot_paths >"$old"
    echo "Watching readable GPIO and LED-class values for $seconds seconds."
    echo 'Press and release the physical control several times.'
    end=$(( $(date +%s 2>/dev/null || echo 0) + seconds ))
    while [ "$(date +%s 2>/dev/null || echo 0)" -lt "$end" ]; do
        sleep 1
        snapshot_paths >"$new"
        if ! cmp -s "$old" "$new"; then
            echo "--- change at $(date 2>/dev/null || true) ---"
            diff -u "$old" "$new" 2>/dev/null || true
            cp "$new" "$old"
        fi
    done
    rm -f "$old" "$new"
    echo 'Watch complete. Event-only input devices may require a follow-up evdev mapping build.'
}

command=${1:-all}
case "$command" in
    refresh) refresh ;;
    reset-button)
        refresh
        echo 'Registered runtime controls:'; cat "$RUNTIME_JSON"; echo
        inventory_reset
        [ "${2:-}" = --watch ] && watch_changes "${3:-30}"
        ;;
    leds)
        refresh
        echo 'Registered runtime controls:'; cat "$RUNTIME_JSON"; echo
        inventory_leds
        [ "${2:-}" = --watch ] && watch_changes "${3:-30}"
        ;;
    all)
        refresh; cat "$RUNTIME_JSON"; echo; inventory_reset; echo; inventory_leds ;;
    *) echo 'usage: postmerkos-hwprobe refresh|reset-button [--watch [SECONDS]]|leds [--watch [SECONDS]]|all' >&2; exit 2 ;;
esac

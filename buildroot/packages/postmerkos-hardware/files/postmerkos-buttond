#!/bin/sh
set -eu
CONFIG=/config/postmerkos/security.json
button_path=$(sed -n 's/.*"reset_button_path"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$CONFIG" 2>/dev/null | head -n1)
active=$(sed -n 's/.*"reset_button_active"[[:space:]]*:[[:space:]]*\([01]\).*/\1/p' "$CONFIG" 2>/dev/null | head -n1)
active=${active:-0}
[ -n "$button_path" ] && [ -r "$button_path" ] || exit 0
held=0
while :; do
    value=$(cat "$button_path" 2>/dev/null || echo 1)
    if [ "$value" = "$active" ]; then
        held=$((held+1))
        [ "$held" -eq 1 ] && postmerkos-ledctl acquire reset
        postmerkos-ledctl reset-step "$held"
        if [ "$held" -ge 10 ]; then
            postmerkos-ledctl all-off
            exec fw_factory_reset --yes
        fi
    else
        [ "$held" -gt 0 ] && { postmerkos-ledctl release reset; held=0; }
    fi
    sleep 1
done

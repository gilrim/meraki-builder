#!/bin/sh
case "${1:-start}" in
  start)
    /usr/sbin/postmerkos-buttond >/run/postmerkos/buttond.log 2>&1 &
    /usr/sbin/postmerkos-poe-prune >/run/postmerkos/poe-prune.log 2>&1 &
    ;;
  stop) killall postmerkos-buttond postmerkos-poe-prune >/dev/null 2>&1 || true ;;
  restart) "$0" stop; "$0" start ;;
esac

config BR2_PACKAGE_POSTMERKOS_HARDWARE
	bool "postmerkOS hardware policy helpers"
	default y
	select BR2_PACKAGE_CONFIGD
	select BR2_PACKAGE_FWUPDATE
	select BR2_PACKAGE_JSON_C
	help
	  Capability-v3 chassis hardware support, including exact-model GPIO
	  discovery, verified reset-button hold handling, status-LED ownership,
	  firmware/reset indication, and one-shot PoE boot-prune policy.
	  Destructive reset is enabled only for hardware-verified profiles.

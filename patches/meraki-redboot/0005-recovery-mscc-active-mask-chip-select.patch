+    /* Actively deselect CS0 while preserving the current clock level. */
+    value &= ~SPI_SW_CS_MASK;
+    spi_write(value);
+
+    /* Stop driving SCK, then release the complete software-mode register. */
+    value &= ~SPI_SW_SCK_OE;

+    puts_b(" REQUESTED="); hex32(requested); puts_b(" OBSERVED="); hex32(observed); puts_b("\n");
+    if ((observed & SPI_GENERAL_CTRL_ENABLE_MASK) != SPI_GENERAL_CTRL_ENABLE_MASK) {

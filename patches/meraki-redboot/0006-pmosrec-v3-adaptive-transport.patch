+    puts_b("PMOSREC CONFIRMATION-WAIT ENTER=ERASEFLASH+"); hex32(nonce);
+    puts_b(" POWER-CYCLE-TO-CANCEL\n");
+    while (read_confirmation_once(nonce) != 0) {
+        puts_b("PMOSREC CONFIRMATION-REJECTED EXPECTED=ERASEFLASH "); hex32(nonce);

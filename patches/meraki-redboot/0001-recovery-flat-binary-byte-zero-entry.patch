diff --git a/payloads/uart-firmware-recovery/entry.S b/payloads/uart-firmware-recovery/entry.S
new file mode 100644
index 0000000..ae798dc
--- /dev/null
+++ b/payloads/uart-firmware-recovery/entry.S
@@ -0,0 +1,33 @@
+/* Flat-binary entry veneer for the pre-kernel recovery payload. */
+    .set noreorder
+    .section .text.start, "ax", @progbits
+    .global _start
+    .ent _start
+_start:
+    /* Keep the recovery stack below the 0x81400000 firmware staging area. */
+    lui     $sp, 0x813f
+    ori     $sp, $sp, 0xf000
+
+    /* Initialise gp even when a newer compiler emits small-data references. */
+    lui     $gp, %hi(_gp)
+    addiu   $gp, $gp, %lo(_gp)
+
+    /* Flat objcopy images do not contain NOBITS data; clear .bss explicitly. */
+    lui     $t0, %hi(__bss_start)
+    addiu   $t0, $t0, %lo(__bss_start)
+    lui     $t1, %hi(__bss_end)
+    addiu   $t1, $t1, %lo(__bss_end)
+1:
+    beq     $t0, $t1, 2f
+     nop
+    sw      $zero, 0($t0)
+    b       1b
+     addiu  $t0, $t0, 4
+2:
+    jal     recovery_main
+     nop
+3:
+    wait
+    b       3b
+     nop
+    .end _start
diff --git a/payloads/uart-firmware-recovery/linker.ld b/payloads/uart-firmware-recovery/linker.ld
index 3d8914e..048b662 100644
--- a/payloads/uart-firmware-recovery/linker.ld
+++ b/payloads/uart-firmware-recovery/linker.ld
@@ -1,3 +1,46 @@
 OUTPUT_ARCH(mips)
 ENTRY(_start)
-SECTIONS { . = 0x81000000; .text : { *(.text*) *(.rodata*) } .data : { *(.data*) } .bss : { *(.bss*) *(COMMON) } }
+SECTIONS
+{
+  . = 0x81000000;
+  __recovery_load_start = .;
+
+  .text : ALIGN(4)
+  {
+    KEEP(*(.text.start))
+    *(.text*)
+    *(.rodata*)
+  }
+
+  .data : ALIGN(16)
+  {
+    _gp = . + 0x7ff0;
+    *(.got*)
+    *(.sdata*)
+    *(.data*)
+  }
+
+  .bss (NOLOAD) : ALIGN(16)
+  {
+    __bss_start = .;
+    *(.sbss*)
+    *(.bss*)
+    *(COMMON)
+    __bss_end = ALIGN(4);
+  }
+
+  __recovery_load_end = .;
+
+  /DISCARD/ :
+  {
+    *(.MIPS.abiflags)
+    *(.reginfo)
+    *(.pdr)
+    *(.comment)
+    *(.note*)
+    *(.gnu.attributes)
+  }
+
+  ASSERT(_start == 0x81000000, "recovery flat-binary entry is not byte zero")
+  ASSERT(__recovery_load_end < 0x81400000, "recovery payload overlaps firmware staging")
+}
